# i3 config file (v4)

set $mod Mod4

default_border none
default_floating_border none

hide_edge_borders smart
smart_borders on

gaps inner 10

smart_gaps inverse_outer

font pango:DejaVu Sans Mono 10

# .xinitrc starts i3 via a bare `dbus-run-session i3`, so DISPLAY/XAUTHORITY
# never reach the systemd --user manager. Without this, any systemd user
# service that needs the display (e.g. autorandr.service) fails with
# "Can't open display" when triggered outside a shell that already has
# those vars (like from a udev rule). dbus-update-activation-environment
# doesn't work here since dbus-run-session spawns its own private bus
# instead of using the systemd-managed per-user one; set-environment
# talks to systemd directly and works regardless.
# DBUS_SESSION_BUS_ADDRESS is included for the same reason: dunst is
# dbus-activated on this private bus, not on the systemd --user bus
# (/run/user/$UID/bus), so systemd user services (e.g. batsignal) that
# don't also get this var send notify calls into the void.
exec --no-startup-id systemctl --user set-environment DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS

# Bare i3 has no polkit agent by default, so anything gated by polkit
# (fprintd enroll, udisks2 mounts, NetworkManager) fails with no auth prompt.
exec --no-startup-id lxpolkit

exec_always --no-startup-id feh --bg-fill ~/.config/i3/wallpapers/tropic_island_day.jpg
exec_always --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- $HOME/.local/bin/i3lock-color --nofork --indicator
exec_always --no-startup-id echo -e "connect 23:02:24:14:13:2E" | bluetoothctl
exec_always --no-startup-id echo -e "nconnect 74:45:CE:F5:01:59" | bluetoothctl

exec --no-startup-id firefox
exec --no-startup-id slack

bindsym $mod+m bar mode toggle

bindsym XF86MonBrightnessUp exec --no-startup-id xbacklight -inc 10
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 10

bindsym $mod+shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exit

bindsym $mod+d exec "rofi -modi drun,run -show drun"
bindsym $mod+Shift+s exec "flameshot gui"
bindsym $mod+Escape exec --no-startup-id loginctl lock-session

bindsym $mod+ctrl+v split vertical
bindsym $mod+ctrl+h split horizontal 
bindsym $mod+f fullscreen toggle

bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right 
bindsym $mod+h focus left 

bindsym $mod+shift+h move left 
bindsym $mod+shift+l move right 
bindsym $mod+shift+j move down 
bindsym $mod+shift+k move up 

bindsym $mod+space focus mode_toggle

bindsym $mod+ctrl+shift+h move workspace to output right
bindsym $mod+ctrl+shift+l move workspace to output left 


bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1:"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5:"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8:"
set $ws9 "9:"
set $ws10 "10:"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Auto-assign apps to workspaces (icons for these are set on the $wsN
# names above; classes confirmed live via `xprop WM_CLASS`).
# assign rules are evaluated top-to-bottom, first match wins, so the
# per-project VS Code title matches must come before the catch-all.
assign [class="^firefox$"]                                      $ws1
assign [class="^code$" title=".* - cld - Visual Studio Code$"]  $ws7
assign [class="^code$" title=".* - 2025 - Visual Studio Code$"] $ws7
assign [class="^code$"]                                         $ws5
assign [class="^org\.wezfurlong\.wezterm$"]                     $ws8
assign [class="^AWS VPN Client$"]                               $ws8
assign [class="^postman$"]                                      $ws9
assign [class="^slack$"]                                        $ws10



mode "resize" {
        bindsym shift+l resize shrink left 5 px or 5 ppt
        bindsym shift+j resize shrink up 5 px or 5 ppt
        bindsym shift+k resize shrink down 5 px or 5 ppt
        bindsym shift+h resize shrink right 5 px or 5 ppt

	bindsym h resize grow left 5 px or 5 ppt
        bindsym j resize grow up 5 px or 5 ppt
        bindsym j resize grow down 5 px or 5 ppt
        bindsym l resize grow right 5 px or 5 ppt


        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Entered/exited via `i3-msg mode nav|default`, driven by the
# kanata-nav-indicator script when the kanata hjkl -> arrow-key layer
# toggles (see nixos/programs/kanata/). i3 silently refuses to switch
# into a mode with zero bindsyms (confirmed via get_binding_state), so
# this has a placeholder binding even though kanata handles the real
# arrow-key remapping below i3's view.
mode "nav" {
  bindsym $mod+shift+n mode "default"
}


#Theme
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b


# target                 title     bg    text   indicator  border
client.focused           $lavender $base $text  $rosewater $lavender
client.focused_inactive  $overlay0 $base $text  $rosewater $overlay0
client.unfocused         $overlay0 $base $text  $rosewater $overlay0
client.urgent            $peach    $base $peach $overlay0  $peach
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base

# bar
bar {

  i3bar_command i3bar --transparency
  status_command i3blocks
  font pango:FiraCode Nerd Font 13
  strip_workspace_numbers yes
  mode hide
  padding 10px 0
  tray_padding 0
  separator_symbol ":|:"
  workspace_min_width 40

  colors {
    background         $base
    statusline         $text
    focused_statusline $text
    #focused_separator $text
    focused_workspace  $base $base $green
    active_workspace   $base $base $blue
    inactive_workspace $base $base $subtext0
    urgent_workspace    $peach $peach $base
    binding_mode       $base $base $mauve
  }
}




