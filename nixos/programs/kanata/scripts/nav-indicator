#!/usr/bin/env python3
"""Bridge kanata's TCP layer-change events to a visible i3 cue.

Kanata reports every layer switch over its --port socket (see
kanata.kbd / common.nix). When the "nav" layer (hjkl -> arrow keys)
becomes active, this un-hides the i3 bar and enters i3's own "nav"
mode, so the bar's existing mode-indicator segment (the one that
already shows "resize") shows "nav" too.
"""
import json
import socket
import subprocess
import time

PORT = 5829


def set_nav_active(active: bool) -> None:
    # hidden_state (not mode) matches what the Win-key peek already does:
    # an overlay that doesn't re-tile/displace windows. Toggling `mode`
    # itself (dock/hide) also triggers an i3bar bug that mispositions the
    # bar on outputs with a non-zero origin (e.g. eDP-1 at x=2560).
    mode = "nav" if active else "default"
    hidden_state = "show" if active else "hide"
    subprocess.run(["i3-msg", "mode", mode], capture_output=True)
    subprocess.run(["i3-msg", "bar", "hidden_state", hidden_state], capture_output=True)


def main() -> None:
    while True:
        try:
            with socket.create_connection(("127.0.0.1", PORT)) as sock:
                buffer = ""
                while True:
                    data = sock.recv(4096).decode()
                    if not data:
                        break
                    buffer += data
                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        if not line:
                            continue
                        msg = json.loads(line)
                        if "LayerChange" in msg:
                            set_nav_active(msg["LayerChange"]["new"] == "nav")
        except OSError:
            pass
        time.sleep(2)


if __name__ == "__main__":
    main()
