#!/usr/bin/env python3
"""Bridge kanata's TCP layer-change events to a visible i3 cue.

Kanata reports every layer switch over its --port socket (see
kanata.kbd / common.nix). When the "nav" layer (hjkl -> arrow keys)
becomes active, this un-hides the i3 bar and lights up the [nav]
i3blocks segment, so it's obvious hjkl no longer types letters.
"""
import json
import os
import socket
import subprocess
import time

PORT = 5829
I3BLOCKS_SIGNAL = 10
FLAG_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kanata-nav-active")


def set_nav_active(active: bool) -> None:
    if active:
        with open(FLAG_PATH, "w") as f:
            f.write("NAV")
        bar_mode = "dock"
    else:
        try:
            os.remove(FLAG_PATH)
        except FileNotFoundError:
            pass
        bar_mode = "hide"

    subprocess.run(["i3-msg", "bar", "mode", bar_mode], capture_output=True)
    subprocess.run(["pkill", f"-RTMIN+{I3BLOCKS_SIGNAL}", "i3blocks"], capture_output=True)


def main() -> None:
    while True:
        try:
            with socket.create_connection(("127.0.0.1", PORT)) as sock:
                buffer = ""
                while True:
                    data = sock.recv(4096).decode()
                    if not data:
                        break
                    buffer += data
                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        if not line:
                            continue
                        msg = json.loads(line)
                        if "LayerChange" in msg:
                            set_nav_active(msg["LayerChange"]["new"] == "nav")
        except OSError:
            pass
        time.sleep(2)


if __name__ == "__main__":
    main()
