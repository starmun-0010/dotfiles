(defsrc
  tab
  esc
  caps
  lsgt
  g
  h
  j
  k
  l
  ;
)

(deflayer some
  @tabmeta
  @nav-on
  @escctrl
  lsft
  g
  h
  j
  k
  l
  ;
)

(deflayer nav
  @tabmeta
  @nav-off
  @escctrl
  lsft
  home
  left
  down
  up
  rght
  end
)

(defcfg
  process-unmapped-keys yes
)

(defalias
  ;; tap for caps lock, hold for left control
  ;; tap-hold-press (not plain tap-hold): resolve to hold as soon as
  ;; another key is pressed, so fast chords like ctrl+a aren't misread as taps
  escctrl (tap-hold-press 200 200 esc lctl)
  tabmeta (tap-hold-press 200 200 tab lmet)
  ;; physical Esc key: tap flips into the hjkl -> arrow-key nav layer and
  ;; stays there until tapped again (layer-switch persists, unlike
  ;; layer-while-held); hold still sends real Caps Lock, since that's now
  ;; rarely needed with the caps-lock key itself remapped to esc/ctrl above
  nav-on (tap-hold-press 200 200 (layer-switch nav) caps)
  nav-off (tap-hold-press 200 200 (layer-switch some) caps)
)
